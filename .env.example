NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_HELP_URL=https://help.earnproof.com

# Production deployments must set the origin variables above.
# Preview builds use the Vercel preview URL plus these testnet defaults when
# project env vars are not configured.
# Local `next build` (including CI without Vercel env) uses these defaults.
# Set EARNPROOF_REQUIRE_SECURITY_ORIGINS=true to fail closed without origins.
# NEXT_PUBLIC_STELLAR_EXPLORER_URL=
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
# Client error telemetry (see docs/observability.md). Both are optional and
# unset by default: with no endpoint, no error event is ever built or sent.
# NEXT_PUBLIC_ERROR_TELEMETRY_ENDPOINT=
# NEXT_PUBLIC_ERROR_TELEMETRY_SAMPLE_RATE=0
# NEXT_PUBLIC_RELEASE=
