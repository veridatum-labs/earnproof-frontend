#!/bin/sh
set -eu

staged_files="$(git diff --cached --name-only --diff-filter=ACMRD)"

if [ -z "$staged_files" ]; then
  exit 0
fi

echo "pre-commit: scanning for known malware indicators..."
node scripts/security/scan-malware.mjs

if ! printf '%s\n' "$staged_files" | grep -Eq '\.(cjs|css|js|jsx|json|mjs|ts|tsx)$'; then
  echo "pre-commit: no frontend code or configuration changes; skipping tests."
  exit 0
fi

echo "pre-commit: running frontend unit tests..."
npm test -- --runInBand
